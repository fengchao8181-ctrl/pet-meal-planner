# pet-meal-planner 运行时环境变量模板
# 复制为 .env 并按需填充；服务通过 createFeishuRepositoryFromEnv / process.env 读取。
#
# ===== 飞书多维表格（运行时持久化）=====
# 以下为占位符！请勿把真实值写入本文件（会被提交进仓库）。复制到不纳入版本控制的 .env 后填真实值。
# base_token / table_id 已通过与你的飞书账号联调确认（Base「宠物餐单定制服务」，三个基础表字段齐备）
FEISHU_BASE_TOKEN=__你的BaseToken__
FEISHU_TABLE_PROFILE=__你的档案table_id__
FEISHU_TABLE_PLAN=__你的餐单table_id__
FEISHU_TABLE_ORDER=__你的订单table_id__
# ↓↓ 唯一缺的：请到飞书开放平台创建自建应用，获取以下两项，并把应用「添加为」该 Base 的协作者（否则无权读写）↓↓
FEISHU_APP_ID=__你的自建应用AppID__
FEISHU_APP_SECRET=__你的自建应用AppSecret__

# 未配置 FEISHU_BASE_TOKEN 时服务退回内存 Mock，便于本地/CI。填齐上方后即启用飞书持久化。

# ===== 微信支付（M2.02，可选；不填则走 Stub 兜底）=====
# WXPAY_MCHID=商户号
WXPAY_APPID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY=
WXPAY_API_V3_KEY=
WXPAY_NOTIFY_URL=
WXPAY_PLATFORM_PUBLIC_KEY=
# WXPAY_DEFAULT_OPENID=可选测试openid